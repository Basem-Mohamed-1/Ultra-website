{
  "name": "ultra-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "start:server": "node --env-file-if-exists=.env server/index.js",
    "admin:create": "node --env-file-if-exists=.env server/create-admin.js",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist",
    "cf:d1:create": "wrangler d1 create ultra-leads",
    "cf:d1:migrate:local": "wrangler d1 migrations apply ultra-leads --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply ultra-leads --remote",
    "cf:admin:create": "node scripts/create-cloudflare-admin.js",
    "cf:build": "npm run build && wrangler pages functions build --outdir .cloudflare-worker"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "vite": "^6.0.0"
  }
}
